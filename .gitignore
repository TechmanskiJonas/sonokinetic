# environment
.venv/
__pycache__/
.pytest_cache/

# render cache and outputs
.cache/
renders/
exports/

# audio: source tracks are not distributable and renders derive from them
*.mp3
*.wav
*.flac
*.ogg
*.aif
*.aiff
*.m4a
uploads/

# derived timelines from local renders
variations.json
compare.json
arrangement.json

# per-user data
sessions/
feedback/
presets/

# local machine settings
.claude/settings.local.json


# Measured HRTF sets: freely downloadable, and large enough not to vendor.
# app.py names one in the Front or back experiment; see the README.
hrtf/

# The public demo page under docs/ is the exception to the audio rule above.
# Its renders are generated by build_demo.py from beds synthesised by
# make_demo_audio.py, so nothing here derives from a recording that could not
# be distributed, and the page is useless without them.
!docs/data/*.mp3
